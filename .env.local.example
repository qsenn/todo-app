# Copy to .env.local (or .env) and fill in. Never commit the real values.

# MongoDB connection string (local, Docker, or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/kanban-goal-tracker

# GitHub OAuth App (see docs/GITHUB_OAUTH.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional public URL of this app (defaults to the request origin); the OAuth callback is <APP_URL>/auth/github/callback
APP_URL=http://localhost:3000
